  "verificationClasses": {
    "LOCAL_REQUIRED_RUN": "A behaviour suite that runs in the required profile on the build machine alone. It needs no container and no credential.",
    "PINNED_FIXTURE_REQUIRED_RUN": "A behaviour suite that runs in the required profile against a pinned container fixture from build/test-infrastructure/compose.yaml, started by tools/ci/run_broker_category.py.",
    "REAL_EPHEMERAL_CLOUD": "A behaviour suite that needs a real, short lived cloud resource. It is not executed here and can never report a pass. This is a visible open proof, never a gate.",
    "COMPILE_AND_PACK_PROOF": "A shipped capability with no behaviour suite of its own, exercised by the suites that use it. It is proven by compiling and packing.",
    "DEVELOPER_TOOL_COMPILE_PROOF": "Not shipped to a consumer. It is proven by compiling, and by its own tests where it has them.",
    "SUPPORT_LIBRARY": "Compiled and exercised through the capabilities that reference it; it carries no category of its own."
  },
  "duenessClasses": {
    "NOT_DUE_EXTERNAL_INFRASTRUCTURE": "Needs a service or credential this work package pins no fixture for. Forbidden in a category that runs against a pinned fixture: nine cases hid behind it while the broker they needed was exactly the one the required profile starts.",
    "NOT_DUE_BENCHMARK": "Measures throughput or timing instead of behaviour.",
    "NOT_DUE_TIMING_SENSITIVE": "Asserts against a wall clock interval and is not stable in a loaded full run.",
    "NOT_DUE_MANUAL_OBSERVATION": "Produces output for a human; asserts nothing a gate could evaluate.",
    "NOT_DUE_ENVIRONMENT_DEPENDENT": "Depends on host environment the run deliberately pins.",
    "NOT_DUE_DEFECTIVE_IMPORTED_ASSURANCE": "Asserts an outcome its own configuration never engages. Measured against both engines, and kept out with the measurement written down until the intended mechanism is decided. The other five classes state why a sound case cannot run here; none of them can state that the case itself is unsound, and forcing it into one of them would be false.",
    "NOT_DUE_REAL_CLOUD_RESOURCE": "Needs a real, short lived cloud resource that no container can stand in for. This is the only class a category with a pinned fixture may use, and it can never become a pass: the capability matrix carries the same statement as REAL_EPHEMERAL_CLOUD."
  },
  "floorSemantics": "minimumExecutedCases is the number of cases the category executed when it was last recorded. tools/ci/run_test_category.py fails a run that executes fewer, because coverage can fall without a single failure: a new exclusion, a renamed fixture or a narrowing filter all leave the counters green. Raising a floor is a normal part of adding cases; lowering one is a decision that belongs in a record.",
  "openDefectsNotInventoried": {
    "statement": "Empty. All five cases record 0025 raised as F-1 are closed by product corrections and by two adjustments the product owner authorised on 2026-08-10, which are to be reported to the lead architect. Every one of them now runs in the required category. A case leaves this list by being fixed and executed, never by being reclassified.",
    "cases": [],
    "count": 0
  },
