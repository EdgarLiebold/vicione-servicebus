<Project>
  <!-- The late half of the central build contract.

       Directory.Build.props is imported before a project's own content and therefore states defaults
       a project may still override. This file is imported after it, so what it asserts is the state
       the project actually ended up in. That is the only place where three promises this repository
       makes can be checked at all, because each of them is about a value a project could have changed
       after the props were read.

       These are build errors, not warnings. A warning in a repository that builds with warnings as
       errors is the same thing with a longer path, and a warning in one that does not is a note
       nobody reads. -->

  <!-- 1. Every project resolves against a tracked lock file, and it resolves in locked mode.

       Directory.Build.props sets both, and a project can turn either off in its own PropertyGroup.
       Checking only the first left the second open: a project could keep its lock file and resolve
       past it, which is the very thing the lock file exists to prevent.

       Updating a package is the one legitimate exception, and it says so on the command line rather
       than in a file: the documented update call passes RestoreLockedMode=false and force evaluation
       on the command line. A property passed globally reaches every project; one written into a
       project reaches only that one, and nobody reading the diff of a package update would see it. That is the difference this pair of
       gates encodes, and RestoreLockedModeFromCommandLine is what tells them apart. -->
  <Target Name="AssertLockedRestoreIsIntact"
          BeforeTargets="CollectPackageReferences">
    <Error Code="VOSB0001"
           Text="$(MSBuildProjectName) turned RestorePackagesWithLockFile off. Every project of this repository resolves against a tracked packages.lock.json; see docs/build.md for how a package is updated."
           Condition=" '$(RestorePackagesWithLockFile)' != 'true' " />
    <Error Code="VOSB0006"
           Text="$(MSBuildProjectName) turned RestoreLockedMode off in the project. Updating a package is done on the command line, where the whole run sees it: dotnet restore -p:RestoreLockedMode=false --force-evaluate."
           Condition=" '$(RestoreLockedMode)' != 'true' AND '$(RestoreLockedModeFromCommandLine)' != 'true' " />
  </Target>

  <!-- 2. A packable project carries the licence evidence Apache 2.0 section 4(b) asks for.

       The readme is added centrally in src/Directory.Build.props. A project that unsets PackageId or
       drops the readme would still pack, and the package would ship without the file the notice
       promises is in it. -->
  <Target Name="AssertPackagedProjectsCarryTheirNotice"
          BeforeTargets="GenerateNuspec"
          Condition=" '$(IsPackable)' == 'true' ">
    <Error Code="VOSB0002"
           Text="$(MSBuildProjectName) is packable but declares no PackageLicenseExpression, so the package would ship without the licence it is distributed under."
           Condition=" '$(PackageLicenseExpression)' == '' AND '$(PackageLicenseFile)' == '' " />
    <Error Code="VOSB0003"
           Text="$(MSBuildProjectName) is packable but names no PackageReadmeFile, so the package would ship without the notice this fork is required to carry."
           Condition=" '$(PackageReadmeFile)' == '' " />
  </Target>

  <!-- 3. Nothing builds for a framework this product does not support.

       net10.0 is the product target. netstandard2.0 has two narrow exceptions and they are not the
       same thing, which is why they are no longer called by one name:

       IsRoslynComponent is the standard property and it fits exactly two projects, the analyzer and
       its code fixes. Those assemblies are loaded by the compiler rather than by the application, so
       they cannot be net10.0.

       ViciOneAnalyzerPackageSurface is the third project, and it is not a compiler host: it compiles
       nothing, ships no build output and loads into nothing. Its framework is a consumer surface. An
       analyzer package carries no lib/ folder, so the framework group of its nuspec is what decides
       which projects may reference it. Measured on 2026-08-19: on net10.0 the package contents are
       byte identical and that one group changes from .NETStandard2.0 to net10.0, which narrows who
       may reference it. That is a capability, so the target stays and the reason is stated. -->
  <Target Name="AssertTargetFrameworkIsSupported"
          BeforeTargets="BeforeBuild"
          Condition=" '$(TargetFramework)' != '' ">
    <Error Code="VOSB0004"
           Text="$(MSBuildProjectName) targets $(TargetFramework). This product targets net10.0; netstandard2.0 is reserved for the two Roslyn components and the analyzer package project."
           Condition=" '$(TargetFramework)' != 'net10.0' AND '$(TargetFramework)' != 'netstandard2.0' " />
    <Error Code="VOSB0005"
           Text="$(MSBuildProjectName) targets netstandard2.0 while being neither a Roslyn component nor the analyzer package project. Both exceptions are stated in docs/build.md: IsRoslynComponent for an assembly the compiler loads, ViciOneAnalyzerPackageSurface for the package whose framework group decides which consumers may reference it."
           Condition=" '$(TargetFramework)' == 'netstandard2.0' AND '$(IsRoslynComponent)' != 'true' AND '$(ViciOneAnalyzerPackageSurface)' != 'true' " />
  </Target>

</Project>
