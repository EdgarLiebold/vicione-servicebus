<Project>
  <!-- The late half of the central build contract.

       Directory.Build.props is imported before a project's own content and therefore states defaults
       a project may still override. This file is imported after it, so what it asserts is the state
       the project actually ended up in. That is the only place where three promises this repository
       makes can be checked at all, because each of them is about a value a project could have changed
       after the props were read.

       These are build errors, not warnings. A warning in a repository that builds with warnings as
       errors is the same thing with a longer path, and a warning in one that does not is a note
       nobody reads. -->

  <!-- Configuration and package-provided project classification are final when targets are imported.
       Product assemblies use full symbols for Debug and embedded symbols for Release. Microsoft
       Testing Platform applications are the deliberate exception: xUnit's MTP package requires a
       portable PDB for discovery, so applying the product Release policy to a native test executable
       produces a successful build whose MTP run discovers zero tests. -->
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' AND '$(IsTestingPlatformApplication)' != 'true' ">
    <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' AND '$(IsTestingPlatformApplication)' != 'true' ">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(IsTestingPlatformApplication)' == 'true' ">
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <!-- 1. Every project resolves against a tracked lock file, and it resolves in locked mode.

       Directory.Build.props sets both, and a project can turn either off in its own PropertyGroup.
       Checking only the first left the second open: a project could keep its lock file and resolve
       past it, which is the very thing the lock file exists to prevent.

       Updating a package is the one legitimate exception, and it says so on the command line rather
       than in a file: the documented update call passes RestoreLockedMode=false and force evaluation
       on the command line. A property passed globally reaches every project; one written into a
       project reaches only that one, and nobody reading the diff of a package update would see it. That is the difference this pair of
       gates encodes, and RestoreLockedModeFromCommandLine is what tells them apart. -->
  <Target Name="AssertLockedRestoreIsIntact"
          BeforeTargets="CollectPackageReferences">
    <Error Code="VOSB0001"
           Text="$(MSBuildProjectName) turned RestorePackagesWithLockFile off. Every project of this repository resolves against a tracked packages.lock.json; see docs/build.md for how a package is updated."
           Condition=" '$(RestorePackagesWithLockFile)' != 'true' " />
    <Error Code="VOSB0006"
           Text="$(MSBuildProjectName) turned RestoreLockedMode off in the project. Updating a package is done on the command line, where the whole run sees it: dotnet restore -p:RestoreLockedMode=false --force-evaluate."
           Condition=" '$(RestoreLockedMode)' != 'true' AND '$(RestoreLockedModeFromCommandLine)' != 'true' " />
  </Target>

  <!-- 2. A packable project carries the licence evidence Apache 2.0 section 4(b) asks for.

       The readme is added centrally in src/Directory.Build.props. A project that unsets PackageId or
       drops the readme would still pack, and the package would ship without the file the notice
       promises is in it. -->
  <Target Name="AssertPackagedProjectsCarryTheirNotice"
          BeforeTargets="GenerateNuspec"
          Condition=" '$(IsPackable)' == 'true' ">
    <Error Code="VOSB0002"
           Text="$(MSBuildProjectName) is packable but declares no PackageLicenseExpression, so the package would ship without the licence it is distributed under."
           Condition=" '$(PackageLicenseExpression)' == '' AND '$(PackageLicenseFile)' == '' " />
    <Error Code="VOSB0003"
           Text="$(MSBuildProjectName) is packable but names no PackageReadmeFile, so the package would ship without the notice this fork is required to carry."
           Condition=" '$(PackageReadmeFile)' == '' " />
  </Target>

  <!-- 3. Nothing builds for a framework this product does not support, and the exceptions are named
       here rather than claimed by the project that wants one.

       net10.0 is the product target. Three projects may use netstandard2.0, and which three is decided
       by their repository relative path below: a marker a project sets about itself is not a control,
       because any project can set it. The measurement behind the third one is in
       evidence/WP-F2-SERVICEBUS-A-PLUS-RECOVERY-03/record-0097; docs/build.md states the rule. -->
  <PropertyGroup>
    <ViciOneProjectIdentity>$([MSBuild]::MakeRelative($(MSBuildThisFileDirectory), $(MSBuildProjectFullPath)))</ViciOneProjectIdentity>
    <ViciOneProjectIdentity>$(ViciOneProjectIdentity.Replace('\','/'))</ViciOneProjectIdentity>

    <_ViciOneExpectedNativeTestTree>false</_ViciOneExpectedNativeTestTree>
    <_ViciOneExpectedNativeTestTree Condition="$([System.String]::Copy('$(ViciOneProjectIdentity)').StartsWith('tests2/'))">true</_ViciOneExpectedNativeTestTree>

    <!-- Loaded by the compiler rather than by the application, so it cannot be a net10.0 assembly. -->
    <ViciOneRoslynComponentProject Condition=" '$(ViciOneProjectIdentity)' == 'src/ViciOne.ServiceBus.Analyzers/ViciOne.ServiceBus.Analyzers.csproj' ">true</ViciOneRoslynComponentProject>
    <ViciOneRoslynComponentProject Condition=" '$(ViciOneProjectIdentity)' == 'src/ViciOne.ServiceBus.Analyzers.CodeFixes/ViciOne.ServiceBus.Analyzers.CodeFixes.csproj' ">true</ViciOneRoslynComponentProject>

    <!-- Compiles nothing and ships no build output. Its framework is the consumer surface of the
         analyzer package: with no lib/ folder, the framework group of the nuspec decides which
         projects may reference it. -->
    <ViciOneAnalyzerPackageProject Condition=" '$(ViciOneProjectIdentity)' == 'src/ViciOne.ServiceBus.Analyzers.Package/ViciOne.ServiceBus.Analyzers.Package.csproj' ">true</ViciOneAnalyzerPackageProject>
  </PropertyGroup>

  <!-- The marker controls central package evaluation, but its authority is the path. Re-derive the
       boundary after the project body and reject both marker spoofing and a native test entry in a
       product or inherited-test project. -->
  <Target Name="AssertNativeTestBoundaryIsIntact"
          BeforeTargets="CollectPackageReferences">
    <ItemGroup>
      <_ViciOneNativeTestEntryReference Include="@(PackageReference)"
                                        Condition=" '%(Identity)' == 'xunit.v3.mtp-v2' " />
    </ItemGroup>
    <Error Code="VOSB0009"
           Text="$(ViciOneProjectIdentity) evaluates ViciOneNativeTestTree=$(ViciOneNativeTestTree), but its repository path requires $(_ViciOneExpectedNativeTestTree). The native test boundary is granted only to projects below tests2/."
           Condition=" '$(ViciOneNativeTestTree)' != '$(_ViciOneExpectedNativeTestTree)' " />
    <Error Code="VOSB0010"
           Text="$(ViciOneProjectIdentity) references xunit.v3.mtp-v2 outside tests2/. Test entry packages must never enter the product or inherited-test project graph."
           Condition=" '$(_ViciOneExpectedNativeTestTree)' != 'true' AND '@(_ViciOneNativeTestEntryReference)' != '' " />
  </Target>

  <Target Name="AssertTargetFrameworkIsSupported"
          BeforeTargets="BeforeBuild"
          Condition=" '$(TargetFramework)' != '' ">
    <Error Code="VOSB0004"
           Text="$(MSBuildProjectName) targets $(TargetFramework). This product targets net10.0; netstandard2.0 is reserved for the two Roslyn components and the analyzer package project."
           Condition=" '$(TargetFramework)' != 'net10.0' AND '$(TargetFramework)' != 'netstandard2.0' " />
    <Error Code="VOSB0005"
           Text="$(ViciOneProjectIdentity) targets netstandard2.0. That exception belongs to three named projects and is granted by path in Directory.Build.targets, not by a property a project sets about itself."
           Condition=" '$(TargetFramework)' == 'netstandard2.0' AND '$(ViciOneRoslynComponentProject)' != 'true' AND '$(ViciOneAnalyzerPackageProject)' != 'true' " />
    <Error Code="VOSB0007"
           Text="$(ViciOneProjectIdentity) declares IsRoslynComponent and is not one of the two Roslyn components of this repository. A copy of an analyzer project is a new project and gets no exception by carrying the marker of an old one."
           Condition=" '$(IsRoslynComponent)' == 'true' AND '$(ViciOneRoslynComponentProject)' != 'true' " />
    <Error Code="VOSB0008"
           Text="$(ViciOneProjectIdentity) declares ViciOneAnalyzerPackageSurface. That property is retired: a project cannot grant itself the framework exception, and the one project that has it is named by path in Directory.Build.targets."
           Condition=" '$(ViciOneAnalyzerPackageSurface)' != '' " />
  </Target>

</Project>
