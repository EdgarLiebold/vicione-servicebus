<Project>
  <!-- Shared by every project in the repository. -->

  <PropertyGroup>
    <!-- Warning level, optimization and the DEBUG/TRACE constants are the SDK defaults and are not
         restated here. CS1591 is the one deliberate exception and is dispositioned against the
         package and documentation policy. -->
    <NoWarn>CS1591</NoWarn>

    <!-- Package evaluation happens before Directory.Build.targets. Derive this boundary from the
         repository-relative project path here, so a project cannot opt into test-only package
         versions by setting a marker about itself. The late build contract independently derives
         the expected value again and rejects any override. -->
    <_ViciOneEarlyProjectIdentity>$([MSBuild]::MakeRelative($(MSBuildThisFileDirectory), $(MSBuildProjectFullPath)))</_ViciOneEarlyProjectIdentity>
    <_ViciOneEarlyProjectIdentity>$(_ViciOneEarlyProjectIdentity.Replace('\','/'))</_ViciOneEarlyProjectIdentity>
    <ViciOneNativeTestTree>false</ViciOneNativeTestTree>
    <ViciOneNativeTestTree Condition="$([System.String]::Copy('$(_ViciOneEarlyProjectIdentity)').StartsWith('tests/'))">true</ViciOneNativeTestTree>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Every project resolves against a tracked packages.lock.json, and locked mode is the default
         rather than a flag the caller has to remember. A restore that would resolve anything other
         than what the lock file records fails, wherever it runs: locally, in CI, in a build and in a
         pack. Updating a package is the one operation that may change the graph, and it says so by
         turning the mode off for itself:

             dotnet restore -p:RestoreLockedMode=false

         after which the changed lock files are reviewed in the diff like any other change. See
         CONTRIBUTING.md. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Remembered before the default is applied, so Directory.Build.targets can tell a caller who
         passed -p:RestoreLockedMode=false apart from a project that wrote it into itself. -->
    <RestoreLockedModeFromCommandLine Condition=" '$(RestoreLockedMode)' != '' ">true</RestoreLockedModeFromCommandLine>
    <RestoreLockedMode Condition=" '$(RestoreLockedMode)' == '' ">true</RestoreLockedMode>
  </PropertyGroup>

  <PropertyGroup>
    <!-- One output root: compilation output under artifacts/sdk, packages under artifacts/packages,
         so a build result can only come from one place. -->
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts/sdk</ArtifactsPath>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts/packages</PackageOutputPath>
  </PropertyGroup>

</Project>
