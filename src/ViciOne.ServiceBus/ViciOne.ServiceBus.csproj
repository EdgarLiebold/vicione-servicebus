<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../signing.props" />

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <PackageTags>ViciOne.ServiceBus</PackageTags>
    <Description>$(Description)</Description>
    <!-- Murmur3UnsafeHashGenerator pins its buffers; without this it reports CS0227. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FastExpressionCompiler" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ViciOne.ServiceBus.Abstractions\ViciOne.ServiceBus.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Sagas/**/*.cs" />
    <Compile Remove="SagaStateMachine/**/*.cs" />
    <Compile Remove="**/*Saga*.cs" />
    <Compile Remove="Configuration/IRequestStateMachineMissingInstanceConfigurator.cs" />
    <Compile Remove="Initializers/PropertyConverters/StatePropertyConverter.cs" />
    <Compile Remove="Initializers/TypeConverters/StateTypeConverter.cs" />
    <Compile Remove="Configuration/DependencyInjection/InMemorySagaRepositoryRegistrationExtensions.cs" />
    <Compile Remove="Configuration/SagaExtensions.cs" />
    <Compile Remove="Configuration/SagaStateMachineReceiveEndpointExtensions.cs" />
    <Compile Remove="DependencyInjection/Configuration/DefaultSagaDefinition.cs" />
    <Compile Remove="DependencyInjection/Configuration/DependencyInjectionSagaRegistrationExtensions.cs" />
    <Compile Remove="DependencyInjection/Configuration/DependencyInjectionSagaStateMachineRegistrationExtensions.cs" />
    <Compile Remove="DependencyInjection/Configuration/InMemorySagaRepositoryRegistrationProvider.cs" />
    <Compile Remove="DependencyInjection/Configuration/RegistrationServiceCollectionExtensions.cs" />
    <Compile Remove="DependencyInjection/Configuration/SagaRepositoryRegistrationProvider.cs" />
    <Compile Remove="DependencyInjection/DependencyInjectionLoadSagaRepository.cs" />
    <Compile Remove="DependencyInjection/DependencyInjectionQuerySagaRepository.cs" />
    <Compile Remove="DependencyInjection/DependencyInjectionSagaRepository.cs" />
    <Compile Remove="DependencyInjection/DependencyInjectionSagaRepositoryContextFactory.cs" />
    <Compile Remove="DependencyInjection/Registration/Sagas/**/*.cs" />
    <Compile Remove="Middleware/MissingSagaPipe.cs" />
    <Compile Remove="Middleware/MissingInstanceRedeliveryPipe.cs" />
    <Compile Remove="Middleware/SendQuerySagaPipe.cs" />
    <Compile Remove="Middleware/SendSagaPipe.cs" />
    <Compile Remove="Middleware/StateMachineSagaMessageFilter.cs" />
    <Compile Remove="Topology/CorrelatedByMessageCorrelationId.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ViciOne.ServiceBus.Tests.InternalAccess" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.Testing" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.ActiveMq" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.AmazonSqs" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.AzureServiceBus" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.AzureServiceBus.Testing" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.Azure.Table" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.EventHubs" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.MessagePack" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.RabbitMq" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.Sagas" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.Courier" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.Futures" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.JobService" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.Mediator" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.Initializers" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.EntityFrameworkCore.Sagas" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.EntityFrameworkCore" Key="" />
  </ItemGroup>
</Project>
