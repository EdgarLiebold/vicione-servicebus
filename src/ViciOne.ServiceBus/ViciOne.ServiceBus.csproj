<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../signing.props" />

  <PropertyGroup>
    <!-- Nullable warnings are completed in work package B; annotations remain active in the interim. -->
    <Nullable>enable</Nullable>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <PackageTags>ViciOne.ServiceBus</PackageTags>
    <Description>$(Description)</Description>
    <!-- Murmur3UnsafeHashGenerator pins its buffers; without this it reports CS0227. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Diagnostics" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ViciOne.ServiceBus.Abstractions\ViciOne.ServiceBus.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ViciOne.ServiceBus.Tests.InternalAccess" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.Testing" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.ActiveMq" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.AmazonSqs" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.AzureServiceBus" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.AzureServiceBus.Testing" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.Azure.Table" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.EventHubs" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.MessagePack" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.RabbitMq" Key="" />
  </ItemGroup>
</Project>
