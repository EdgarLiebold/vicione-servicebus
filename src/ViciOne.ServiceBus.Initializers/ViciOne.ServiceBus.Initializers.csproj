<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../signing.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageTags>ViciOne.ServiceBus;Initializers</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../ViciOne.ServiceBus/ViciOne.ServiceBus.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../ViciOne.ServiceBus.Abstractions/Advanced/Initializers/**/*.cs"
             Exclude="../ViciOne.ServiceBus.Abstractions/Advanced/Initializers/INamedInitializerValue.cs;../ViciOne.ServiceBus.Abstractions/Advanced/Initializers/InitializedMessage.cs"
             Link="Advanced/Initializers/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../ViciOne.ServiceBus.Abstractions/Initializers/Variables/IdVariable.cs"
             Link="Initializers/Variables/IdVariable.cs" />
    <Compile Include="../ViciOne.ServiceBus.Abstractions/Initializers/Variables/TimestampVariable.cs"
             Link="Initializers/Variables/TimestampVariable.cs" />
  </ItemGroup>
</Project>
