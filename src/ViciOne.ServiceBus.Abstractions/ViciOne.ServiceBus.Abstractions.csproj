<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../signing.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <RootNamespace>ViciOne.ServiceBus</RootNamespace>
    <Nullable>enable</Nullable>
    <!-- The four NewId formatters pin their buffers; without this they report CS0227. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <PackageTags>ViciOne.ServiceBus</PackageTags>
    <Description>Public messaging contracts, contexts, topology abstractions, and pipeline primitives for ViciOne.ServiceBus.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Strong-named first-party modules share canonical internal primitives without enlarging the
         public contract with implementation-only envelope, task, URI, and reflection helpers. -->
    <InternalsVisibleTo Include="ViciOne.ServiceBus" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.SqlTransport" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.Sagas" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.Courier" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.Futures" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.JobService" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.Mediator" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.Initializers" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.EntityFrameworkCore.Sagas" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.EntityFrameworkCore" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.MessagePack" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.Testing" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.Abstractions.Tests" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.Tests.InternalAccess" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.ActiveMq" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.AmazonSqs" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.AzureServiceBus" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.EventHubs" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.RabbitMq" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.Azure.Table" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.DynamoDb" Key="" />
  </ItemGroup>
</Project>
