<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../signing.props"/>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <RootNamespace>ViciOne.ServiceBus</RootNamespace>
    <Nullable>enable</Nullable>
    <!-- The four NewId formatters pin their buffers; without this they report CS0227. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <PackageTags>ViciOne.ServiceBus</PackageTags>
    <Description>$(Description)</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Saga/**/*.cs" />
    <Compile Remove="SagaStateMachine/**/*.cs" />
    <Compile Remove="Configuration/DependencyInjection/Configuration/SagaEndpointDefinition.cs" />
    <Compile Remove="Configuration/DependencyInjection/ISagaDefinition.cs" />
    <Compile Remove="Configuration/DependencyInjection/SagaDefinition.cs" />
    <Compile Remove="Mediator/**/*.cs" />
    <Compile Remove="Courier/**/*.cs" />
    <Compile Remove="Exceptions/RoutingSlip*.cs" />
    <Compile Remove="Configuration/Consumers/ICompensateActivityConfigurator.cs" />
    <Compile Remove="Configuration/Consumers/ICompensateActivityLogConfigurator.cs" />
    <Compile Remove="Configuration/Consumers/IExecuteActivityArgumentsConfigurator.cs" />
    <Compile Remove="Configuration/Consumers/IExecuteActivityConfigurator.cs" />
    <Compile Remove="Configuration/Consumers/IRoutingSlipConfigurator.cs" />
    <Compile Remove="Configuration/DependencyInjection/ActivityDefinition.cs" />
    <Compile Remove="Configuration/DependencyInjection/Configuration/CompensateActivityEndpointDefinition.cs" />
    <Compile Remove="Configuration/DependencyInjection/Configuration/ExecuteActivityEndpointDefinition.cs" />
    <Compile Remove="Configuration/DependencyInjection/ExecuteActivityDefinition.cs" />
    <Compile Remove="Configuration/DependencyInjection/IActivityDefinition.cs" />
    <Compile Remove="Configuration/DependencyInjection/IActivityRegistrationConfigurator.cs" />
    <Compile Remove="Configuration/DependencyInjection/IExecuteActivityDefinition.cs" />
    <Compile Remove="Configuration/DependencyInjection/IExecuteActivityRegistrationConfigurator.cs" />
    <Compile Remove="Contexts/CourierContext.cs" />
    <Compile Include="Courier/IItineraryBuilder.cs" Link="Advanced/IItineraryBuilder.cs" />
    <Compile Include="Courier/Contracts/RoutingSlipEvents.cs" Link="Advanced/RoutingSlipEvents.cs" />
    <Compile Include="Courier/Contracts/RoutingSlipEventContents.cs" Link="Advanced/RoutingSlipEventContents.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Envelope metadata is one serializer-independent product rule. The projection remains
         internal so adding a wire format does not enlarge the public API, while the two retained
         serializer assemblies consume the same implementation. -->
    <InternalsVisibleTo Include="ViciOne.ServiceBus" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.Sagas" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.Courier" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.Futures" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.JobService" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.Mediator" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.Initializers" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.EntityFrameworkCore.Sagas" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.EntityFrameworkCore" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.MessagePack" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.Testing" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.Abstractions.Tests" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.ActiveMq" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.AmazonSqs" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.AzureServiceBus" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.EventHubs" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.RabbitMq" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.Azure.Table" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.DynamoDb" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.StateMachineVisualizer" Key="" />
  </ItemGroup>
</Project>
