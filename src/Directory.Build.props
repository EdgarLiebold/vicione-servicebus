<Project>
  <Import Project="..\Directory.Build.props"/>

  <PropertyGroup>
    <Product>ViciOne.ServiceBus</Product>
    <Copyright>Copyright 2007-2024 Chris Patterson</Copyright>
    <Authors>Chris Patterson</Authors>
    <!-- Unsafe code is granted per project, only where the compiler requires it. -->
    <DebugSymbols>True</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup>
    <PackageReadmeFile>NuGet.README.md</PackageReadmeFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/EdgarLiebold/vicione-servicebus</PackageProjectUrl>
    <Description>ViciOne.ServiceBus provides a developer-focused, modern platform for creating distributed applications without complexity.</Description>
    <IsPackable>True</IsPackable>

    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <!-- Every source project packs the repository-level package readme from one location independent of project depth. -->
    <None Include="$(MSBuildThisFileDirectory)..\NuGet.README.md" Pack="true" Visible="false" PackagePath="" />
  </ItemGroup>

</Project>
