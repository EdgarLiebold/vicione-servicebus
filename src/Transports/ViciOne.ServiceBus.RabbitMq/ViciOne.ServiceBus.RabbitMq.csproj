<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../signing.props" />

  <PropertyGroup>
    <!-- Nullable warnings are completed in work package B; annotations remain active in the interim. -->
    <Nullable>enable</Nullable>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <RootNamespace>ViciOne.ServiceBus.RabbitMq</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>ViciOne.ServiceBus.RabbitMq</PackageId>
    <Title>ViciOne.ServiceBus.RabbitMq</Title>
    <PackageTags>ViciOne.ServiceBus;RabbitMQ</PackageTags>
    <Description>ViciOne.ServiceBus RabbitMQ transport support; $(Description)</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RabbitMQ.Client" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ViciOne.ServiceBus\ViciOne.ServiceBus.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The closed-channel failure path remains internal; the companion assembly receives access
         without widening the package API. -->
    <InternalsVisibleTo Include="ViciOne.ServiceBus.RabbitMq.Tests" Key="" />
  </ItemGroup>

</Project>
