<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../signing.props" />

  <PropertyGroup>
    <!-- Nullable warnings are completed in work package B; annotations remain active in the interim. -->
    <Nullable>enable</Nullable>
    <!-- Documentation is completed in work package C; until then CS1591 stays a warning here. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <TargetFramework>net10.0</TargetFramework>
    <Authors>Denys Kozhevnikov, $(Authors)</Authors>
  </PropertyGroup>

  <PropertyGroup>
    <RootNamespace>ViciOne.ServiceBus</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>ViciOne.ServiceBus.EventHub</PackageId>
    <Title>ViciOne.ServiceBus.EventHub</Title>
    <PackageTags>ViciOne.ServiceBus;EventHub</PackageTags>
    <Description>ViciOne.ServiceBus EventHub Support; $(Description)</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Messaging.EventHubs.Processor" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Storage.Blobs" />
    <ProjectReference Include="..\..\ViciOne.ServiceBus\ViciOne.ServiceBus.csproj" />
  </ItemGroup>

</Project>
