<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../signing.props" />

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- The compiler that loads an analyzer is not a net10.0 process, so this project targets
         netstandard2.0. That framework gets neither a language version nor a warning level from the
         SDK, so both are pinned here to the level the rest of the repository builds at. -->
    <LangVersion>14.0</LangVersion>
    <WarningLevel>10</WarningLevel>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Remco Blok, $(Authors)</Authors>
    <PackageTags>ViciOne.ServiceBus</PackageTags>
    <Description>$(Description)</Description>
    <NoPackageAnalysis>true</NoPackageAnalysis>

    <!-- Override the Directory.build.props and disable a snupkg from being created -->
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
    <PackageReference Update="NETStandard.Library" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Update="tools\*.ps1" CopyToOutputDirectory="IfDifferent" Pack="true" PackagePath="" />
    <None Include="$(OutputPath)/$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>
