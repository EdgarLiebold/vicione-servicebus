<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../signing.props" />

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- Marks the assembly for loading by compiler and IDE analyzer hosts. -->
    <IsRoslynComponent>true</IsRoslynComponent>
    <!-- Enables current nullable C# syntax while retaining the Roslyn host target. -->
    <LangVersion>latest</LangVersion>
    <WarningLevel>10</WarningLevel>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- The aggregate analyzer package publishes this compiler-host assembly. -->
    <IsPackable>false</IsPackable>
    <PackageId>ViciOne.ServiceBus.Analyzers.Assembly</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Analyzer execution depends only on compiler-layer Roslyn APIs. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Update="NETStandard.Library" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ViciOne.ServiceBus.Analyzers.CodeFixes" Key="" />
  </ItemGroup>

</Project>
