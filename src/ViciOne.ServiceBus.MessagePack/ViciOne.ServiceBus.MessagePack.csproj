<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../signing.props"/>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ViciOne.ServiceBus.MessagePack</RootNamespace>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>ViciOne.ServiceBus.MessagePack</PackageId>
    <Title>ViciOne.ServiceBus.MessagePack</Title>
    <PackageTags>ViciOne.ServiceBus;MessagePack;MsgPack</PackageTags>
    <Description>ViciOne.ServiceBus MessagePack support; $(Description)</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FastExpressionCompiler"/>
    <PackageReference Include="MessagePack"/>
  </ItemGroup>

  <ItemGroup>
    <!-- The hardened option set is internal, and the security mode it carries cannot be told apart
         from the default one by behaviour alone: both bound the object graph depth, and the property
         that differs is hash collision resistance for dictionary keys. A test that asserts it directly
         is the only one that fails when the hardening is dropped, so the option set is exposed to that
         assembly only. The public surface is unchanged. -->
    <InternalsVisibleTo Include="ViciOne.ServiceBus.Tests" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.MessagePack.Tests" Key="" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ViciOne.ServiceBus.Abstractions\ViciOne.ServiceBus.Abstractions.csproj"/>
    <ProjectReference Include="..\ViciOne.ServiceBus.Courier\ViciOne.ServiceBus.Courier.csproj"/>
    <ProjectReference Include="..\ViciOne.ServiceBus\ViciOne.ServiceBus.csproj"/>
    <ProjectReference Include="..\ViciOne.ServiceBus.JobService\ViciOne.ServiceBus.JobService.csproj"/>
  </ItemGroup>

</Project>
