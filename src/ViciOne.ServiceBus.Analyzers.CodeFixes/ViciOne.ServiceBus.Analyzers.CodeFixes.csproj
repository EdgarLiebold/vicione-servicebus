<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../signing.props" />

  <PropertyGroup>
    <!-- Nullable warnings are completed in work package B; annotations remain active in the interim. -->
    <Nullable>annotations</Nullable>
    <!-- Documentation is completed in work package C; until then CS1591 stays a warning here. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- The standard Roslyn property. It states what this assembly is; it does not grant the
         framework exception - Directory.Build.targets grants that by path. -->
    <IsRoslynComponent>true</IsRoslynComponent>
    <!-- Same host boundary as the analyzer assembly. netstandard2.0 otherwise selects C# 7.3;
         "latest" follows the installed stable SDK and therefore does not pin a language release. -->
    <LangVersion>latest</LangVersion>
    <WarningLevel>10</WarningLevel>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Code fixes run inside an IDE or a fix-all host, which does provide Workspaces. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
    <PackageReference Update="NETStandard.Library" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ViciOne.ServiceBus.Analyzers\ViciOne.ServiceBus.Analyzers.csproj" />
  </ItemGroup>

</Project>
