<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../signing.props" />

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- Marks the assembly for loading by IDE code-fix hosts. -->
    <IsRoslynComponent>true</IsRoslynComponent>
    <!-- Enables current nullable C# syntax while retaining the Roslyn host target. -->
    <LangVersion>latest</LangVersion>
    <WarningLevel>10</WarningLevel>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Code-fix editing and formatting require Roslyn workspace APIs. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
    <PackageReference Update="NETStandard.Library" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ViciOne.ServiceBus.Analyzers\ViciOne.ServiceBus.Analyzers.csproj" />
  </ItemGroup>

</Project>
