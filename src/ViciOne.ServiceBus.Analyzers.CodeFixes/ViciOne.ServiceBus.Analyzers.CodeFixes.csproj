<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../signing.props" />

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- Loaded by the compiler, not by the application, which is why this one project may leave the
         product's net10.0 target. Directory.Build.targets refuses netstandard2.0 without it. -->
    <ViciOneCompilerHost>true</ViciOneCompilerHost>
    <!-- Same reasoning as the analyzer assembly: the host is not a net10.0 process, and
         netstandard2.0 inherits neither setting from the SDK. -->
    <LangVersion>14.0</LangVersion>
    <WarningLevel>10</WarningLevel>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Code fixes run inside an IDE or a fix-all host, which does provide Workspaces. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
    <PackageReference Update="NETStandard.Library" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ViciOne.ServiceBus.Analyzers\ViciOne.ServiceBus.Analyzers.csproj" />
  </ItemGroup>

</Project>
