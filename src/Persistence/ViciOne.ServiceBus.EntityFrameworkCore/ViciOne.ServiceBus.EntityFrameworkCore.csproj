  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ViciOne.ServiceBus\ViciOne.ServiceBus.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Configuration/EntityFrameworkCoreJobServiceConfigurationExtensions.cs" />
    <Compile Remove="Configuration/EntityFrameworkCoreSagaRepositoryRegistrationExtensions.cs" />
    <Compile Remove="Configuration/EntityFrameworkSagaRepositoryConfigurator.cs" />
    <Compile Remove="Configuration/EntityFrameworkSagaRepositoryRegistrationProvider.cs" />
    <Compile Remove="Configuration/IEntityFrameworkSagaRepository.cs" />
    <Compile Remove="Configuration/IEntityFrameworkSagaRepositoryConfigurator.cs" />
    <Compile Remove="EntityFrameworkCoreIntegration/Configuration/EntityFrameworkSagaRepository.cs" />
