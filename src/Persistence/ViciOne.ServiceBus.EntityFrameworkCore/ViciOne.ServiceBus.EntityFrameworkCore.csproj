    <InternalsVisibleTo Include="ViciOne.ServiceBus.EntityFrameworkCore.Tests" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.EntityFrameworkCore.LocalIntegration.Tests" Key="" />
