<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../signing.props" />

  <PropertyGroup>
    <!-- Nullable warnings are completed in work package B; annotations remain active in the interim. -->
    <Nullable>enable</Nullable>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <RootNamespace>ViciOne.ServiceBus.Azure.Table</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      The capability is Azure Table storage, and the project, the assembly and the namespace already
      said so while the package identity still carried the old Azure.Cosmos.Table name. Cosmos DB for
      Table is a supported counterpart that speaks this API, which the description names as such; it
      is not the product identity.
    -->
    <PackageId>ViciOne.ServiceBus.Azure.Table</PackageId>
    <Title>ViciOne.ServiceBus.Azure.Table</Title>
    <PackageTags>ViciOne.ServiceBus;Azure;Table</PackageTags>
    <Description>ViciOne.ServiceBus saga and optional message-journal persistence on Azure Table storage, including Cosmos DB for Table as a supported endpoint of that API; $(Description)</Description>
  </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\ViciOne.ServiceBus\ViciOne.ServiceBus.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Azure.Data.Tables" />
    </ItemGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="ViciOne.ServiceBus.Azure.Table.Tests" Key="" />
    </ItemGroup>

</Project>
