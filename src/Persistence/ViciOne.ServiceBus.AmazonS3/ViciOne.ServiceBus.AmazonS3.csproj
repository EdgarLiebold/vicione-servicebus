<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../../../signing.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <RootNamespace>ViciOne.ServiceBus.AmazonS3</RootNamespace>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>ViciOne.ServiceBus.AmazonS3</PackageId>
    <Title>ViciOne.ServiceBus.AmazonS3</Title>
    <PackageTags>ViciOne.ServiceBus;S3;Storage;ServiceBus</PackageTags>
    <Description>Amazon S3 message-data persistence for ViciOne.ServiceBus.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" />
    <ProjectReference Include="..\..\ViciOne.ServiceBus\ViciOne.ServiceBus.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ViciOne.ServiceBus.AmazonS3.Tests" Key="" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.AmazonS3.LocalIntegration.Tests" Key="" />
  </ItemGroup>
</Project>
