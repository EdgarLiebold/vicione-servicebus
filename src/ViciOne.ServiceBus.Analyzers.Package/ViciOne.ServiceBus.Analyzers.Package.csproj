<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Not a compiler host and not a Roslyn component: this project compiles nothing, ships no
         build output and loads into nothing. Its framework is the one thing a consumer sees, because
         an analyzer package carries no lib/ folder and NuGet decides from the framework group of the
         nuspec which projects may reference it at all. Measured on 2026-08-19: switching this project
         to net10.0 leaves the package contents byte identical - both analyzer assemblies, the readme
         and the two tool scripts - and changes exactly one line of the nuspec, the empty dependency
         group, from .NETStandard2.0 to net10.0. That line is the package's consumer surface, so the
         target stays and the exception is named for what it is rather than called a compiler host. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <ViciOneAnalyzerPackageSurface>true</ViciOneAnalyzerPackageSurface>
    <LangVersion>14.0</LangVersion>
    <WarningLevel>10</WarningLevel>

    <!-- This project carries no logic. It exists so that the analyzer assembly and the code fix
         assembly, which must not live together, still ship as the one package they always were. -->
    <PackageId>ViciOne.ServiceBus.Analyzers</PackageId>
    <AssemblyName>ViciOne.ServiceBus.Analyzers.Package</AssemblyName>
    <RootNamespace>ViciOne.ServiceBus.Analyzers.Package</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <IncludeSymbols>false</IncludeSymbols>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <Authors>Remco Blok, $(Authors)</Authors>
    <PackageTags>ViciOne.ServiceBus</PackageTags>
    <Description>$(Description)</Description>

    <TargetsForTfmSpecificContentInPackage>
      $(TargetsForTfmSpecificContentInPackage);PackAnalyzerAssemblies
    </TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <!-- Referenced for their build output only: neither assembly is a dependency of the package. -->
    <ProjectReference Include="..\ViciOne.ServiceBus.Analyzers\ViciOne.ServiceBus.Analyzers.csproj"
                      PrivateAssets="all" />
    <ProjectReference Include="..\ViciOne.ServiceBus.Analyzers.CodeFixes\ViciOne.ServiceBus.Analyzers.CodeFixes.csproj"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- PackagePath is empty because NuGet keeps the item's own relative directory, so the scripts
         land in tools/ exactly as they do in the project. -->
    <None Update="tools\*.ps1" CopyToOutputDirectory="IfDifferent" Pack="true" PackagePath="" />
  </ItemGroup>

  <Target Name="PackAnalyzerAssemblies">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(OutputPath)ViciOne.ServiceBus.Analyzers.dll"
                              PackagePath="analyzers/dotnet/cs" />
      <TfmSpecificPackageFile Include="$(OutputPath)ViciOne.ServiceBus.Analyzers.CodeFixes.dll"
                              PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>

</Project>
