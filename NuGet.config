<?xml version="1.0" encoding="utf-8"?>
<!--
  Restore sources for this repository.

  Invariant: exactly one source, named here, independent of machine configuration. Both clear
  elements drop inherited entries so no unnamed source can supply a package and no machine level
  entry can disable the only source that remains. The mapping claims every pattern for that source.
  The source is public and anonymous; no credentials belong in this file.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
