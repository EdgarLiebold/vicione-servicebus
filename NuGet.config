<?xml version="1.0" encoding="utf-8"?>
<!--
  Restore sources for this repository.

  Without this file a restore inherits whatever sources the machine happens to have configured. On the
  development machine that was four sources, three of them internal JFrog endpoints, which made every
  restore depend on host state and raised NU1507 because central package management cannot decide which
  source a package must come from.

  clear drops every inherited source, so exactly one source remains and it is named here. The mapping
  claims every package pattern for that source, which is what silences NU1507 and, more importantly,
  makes it impossible for a package to arrive from an unnamed source. disabledPackageSources is cleared
  as well, because a machine level entry could otherwise disable the only source that is left.

  No credentials belong in this file. The single source is public and anonymous.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
