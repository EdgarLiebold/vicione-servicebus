      "oldText": "        async Task<JobKey> EnsureJobExists(CancellationToken cancellationToken)\n        {\n            var jobKey = new JobKey(ScheduleMessageJobId);\n\n            var scheduler = await _schedulerFactory.GetScheduler(cancellationToken).ConfigureAwait(false);\n\n            if (await scheduler.CheckExists(jobKey, cancellationToken).ConfigureAwait(false))\n                return jobKey;\n\n            var jobDetail = JobBuilder.Create<ScheduledMessageJob>()\n                .RequestRecovery()\n                .StoreDurably()\n                .WithIdentity(jobKey)\n                .WithDescription(\"ViciOne.ServiceBus Scheduled Message Job\")\n                .Build();\n\n            await scheduler.AddJob(jobDetail, true, cancellationToken).ConfigureAwait(false);\n\n            return jobKey;\n        }",
      "newText": "        async Task<JobKey> EnsureJobExists(CancellationToken cancellationToken)\n        {\n            var jobKey = new JobKey(ScheduleMessageJobId);\n            const string createdSwitch = \"ViciOne.ServiceBus.QuartzIntegration.JobCreated\";\n\n            if (AppContext.TryGetSwitch(createdSwitch, out bool jobCreated) && jobCreated)\n                return jobKey;\n\n            var scheduler = await _schedulerFactory.GetScheduler(cancellationToken).ConfigureAwait(false);\n\n            if (await scheduler.CheckExists(jobKey, cancellationToken).ConfigureAwait(false))\n                return jobKey;\n\n            var jobDetail = JobBuilder.Create<ScheduledMessageJob>()\n                .RequestRecovery()\n                .StoreDurably()\n                .WithIdentity(jobKey)\n                .WithDescription(\"ViciOne.ServiceBus Scheduled Message Job\")\n                .Build();\n\n            await scheduler.AddJob(jobDetail, true, cancellationToken).ConfigureAwait(false);\n            AppContext.SetSwitch(createdSwitch, true);\n\n            return jobKey;\n        }",
