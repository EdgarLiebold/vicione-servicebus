  "whyThirtyFiveAndThirtySevenBothAppeared": {
    "statement": "Both numbers were right about different things, and neither was an estimate.",
    "resultCount": "1906 discovered minus 1869 executed is 37 not executed results after the removals.",
    "nameCount": "The runner keys a case as the last segment of its class name plus the method name and deduplicates, which yielded 35 names.",
    "theTwoThatCollapse": [
      "ViciOne.ServiceBus.Tests.Middleware.Specifying_a_rate_limit.Should_count_success_and_failure_as_same",
      "ViciOne.ServiceBus.Tests.Middleware.Specifying_a_rate_limit.Should_only_do_n_messages_per_interval",
