+    static ISendTopologyConfigurator SendTopology(ISessionIdFormatter formatter)
+    {
+        ISendTopologyConfigurator topology = new ServiceBusSendTopology();
+        Assert.True(topology.TryAddConvention(new SessionIdSendTopologyConvention { DefaultFormatter = formatter }));
+        return topology;
+    }
+
+    static async Task<AzureServiceBusSendContext<FamilyMessage>> ApplySessionTopologyAsync(
+        ISendTopologyConfigurator topology, string? existingSession = null)
+    {
+        IMessageSendTopologyConfigurator<FamilyMessage> messageTopology = topology.GetMessageTopology<FamilyMessage>();
+        Assert.True(messageTopology.TryGetConvention<ISessionIdMessageSendTopologyConvention<FamilyMessage>>(out _));
+        var builder = new CaptureTopologyBuilder<SendContext<FamilyMessage>>();
+        messageTopology.Apply(builder);
+        Assert.InRange(builder.Filters.Count, 0, 1);
+        var context = new AzureServiceBusSendContext<FamilyMessage>(new FamilyMessage(), TestContext.Current.CancellationToken)
+        {
+            SessionId = existingSession,
+        };
+        context.GetOrAddPayload<ServiceBusSendContext<FamilyMessage>>(() => context);
+        var terminal = new RecordingPipe<SendContext<FamilyMessage>>();
+        if (builder.Filters.Count == 0) await terminal.SendAsync(context);
+        else await builder.Filters[0].SendAsync(context, terminal);
+        Assert.Equal(1, terminal.Calls);
+        Assert.Same(context, terminal.LastContext);
+        return context;
+    }
+
+    static IServiceBusConsumeTopologyConfigurator ConsumeTopology()
+    {
+        IMessageTopologyConfigurator messages = AzureBusFactory.CreateMessageTopology();
+        return new ServiceBusConsumeTopology(messages, new ServiceBusPublishTopology(messages));
+    }
