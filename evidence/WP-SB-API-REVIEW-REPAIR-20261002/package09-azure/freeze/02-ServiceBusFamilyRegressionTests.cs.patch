+    static CreateRuleOptions Rule() => new("review-rule", new TrueRuleFilter());
+
+    static IBusControl BuildSubscriptionBus(bool typed, bool useRule, bool useFilter) =>
+        Bus.Factory.CreateUsingAzureServiceBus(bus => bus.ReceiveEndpoint("review-queue", endpoint =>
+        {
+            void Configure(IServiceBusSubscriptionConfigurator subscription)
+            {
+                if (useRule) subscription.Rule = Rule();
+                if (useFilter) subscription.Filter = new FalseRuleFilter();
+            }
+            if (typed) endpoint.Subscribe<FamilyMessage>("review-forward", Configure);
+            else endpoint.Subscribe("review-topic", "review-forward", Configure);
+        }));
