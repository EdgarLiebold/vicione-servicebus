+    static async Task<SubscriptionDeclaration[]> BuildDeclarationsAsync(string firstPath, string secondPath)
+    {
+        var services = new ServiceCollection();
+        services.AddSingleton<ILoggerFactory>(NullLoggerFactory.Instance);
+        services.TryAdd(ServiceDescriptor.Singleton(typeof(ILogger<>), typeof(NullLogger<>)));
+        services.AddViciOneServiceBus(registration =>
+        {
+            registration.Limits(MessageLimits.Conservative);
+            registration.AddConsumer<FamilyConsumer>();
+            registration.UsingAzureServiceBus((context, bus) =>
+            {
+                bus.ReceiveEndpoint(firstPath, endpoint => endpoint.ConfigureConsumer<FamilyConsumer>(context));
+                bus.ReceiveEndpoint(secondPath, endpoint => endpoint.ConfigureConsumer<FamilyConsumer>(context));
+            });
+        });
+        await using ServiceProvider provider = services.BuildServiceProvider(validateScopes: true);
+        IBusControl busControl = provider.GetRequiredService<IBusControl>();
+        JsonNode probe = JsonSerializer.SerializeToNode(busControl.GetProbeResult(TestContext.Current.CancellationToken),
+            ServiceBusMetadataJson.Options)!;
+        var expectedPaths = new HashSet<string>(new[] { firstPath, secondPath }, StringComparer.Ordinal);
+        SubscriptionDeclaration[] declarations = FindScopes(probe, "queueSubscription")
+            .Select(scope => new SubscriptionDeclaration(
+                scope["subscriptionName"]!.GetValue<string>(), scope["forwardTo"]!.GetValue<string>()))
+            .Where(value => expectedPaths.Contains(value.ForwardTo)).ToArray();
+        Assert.Equal(2, declarations.Length);
+        Assert.Equal(expectedPaths.Order(StringComparer.Ordinal).ToArray(),
+            declarations.Select(value => value.ForwardTo).Order(StringComparer.Ordinal).ToArray());
+        Assert.All(declarations, value => Assert.InRange(value.Name.Length, 1, 50));
+        return declarations;
+    }
+
+    static IEnumerable<JsonObject> FindScopes(JsonNode? node, string scopeName)
+    {
+        if (node is JsonObject obj)
+        {
+            foreach (KeyValuePair<string, JsonNode?> property in obj)
+            {
+                if (property.Key == scopeName)
+                {
+                    if (property.Value is JsonObject single) yield return single;
+                    else if (property.Value is JsonArray array)
+                        foreach (JsonNode? item in array) yield return Assert.IsType<JsonObject>(item);
+                }
+                foreach (JsonObject nested in FindScopes(property.Value, scopeName)) yield return nested;
+            }
+        }
+        else if (node is JsonArray values)
+            foreach (JsonNode? value in values)
+                foreach (JsonObject nested in FindScopes(value, scopeName)) yield return nested;
+    }
+
+    sealed class CaptureTopologyBuilder<T> : ITopologyPipeBuilder<T> where T : class, PipeContext
+    {
+        public List<IFilter<T>> Filters { get; } = new();
+        public bool IsDelegated => false;
+        public bool IsImplemented => false;
+        public ITopologyPipeBuilder<T> CreateDelegatedBuilder() => this;
+        public void AddFilter(IFilter<T> filter) => Filters.Add(filter);
+    }
+
+    sealed class RecordingPipe<T> : IPipe<T> where T : class, PipeContext
+    {
+        public int Calls { get; private set; }
+        public T? LastContext { get; private set; }
+        public Task SendAsync(T context) { Calls++; LastContext = context; return Task.CompletedTask; }
+        public void Probe(ProbeContext context) { }
+    }
+
+    sealed class RecordingSessionFormatter(string? value) : ISessionIdFormatter
+    {
+        public int Calls { get; private set; }
+        public object? LastMessage { get; private set; }
+        public string? FormatSessionId<T>(SendContext<T> context) where T : class
+        { Calls++; LastMessage = context.Message; return value; }
+    }
+
+    sealed record SubscriptionDeclaration(string Name, string ForwardTo);
+    public sealed class FamilyMessage;
+    public sealed class FamilyConsumer : IConsumer<FamilyMessage>
+    {
+        public Task ConsumeAsync(ConsumeContext<FamilyMessage> context) => Task.CompletedTask;
+    }
