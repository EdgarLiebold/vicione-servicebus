+    [RequirementCoverage("REQ-VSB-ASB-SUBSCRIPTION-OPTIONS", "consume-subscriptions-retain-rule-filter-validation")]
+    public void ConsumeSubscriptions_RetainRuleFilterValidation(bool typed)
+    {
+        var direct = new ServiceBusSubscriptionConfigurator("review-forward", "review-topic")
+        {
+            Rule = Rule(),
+            Filter = new FalseRuleFilter(),
+        };
+        Assert.Equal("Rule/Filter", Assert.Single(direct.Validate()).Key);
+
+        foreach (bool useRule in new[] { false, true })
+        {
+            int controlCalls = 0;
+            IServiceBusConsumeTopologyConfigurator control = ConsumeTopology();
+            Subscribe(control, typed, subscription =>
+            {
+                controlCalls++;
+                if (useRule) subscription.Rule = Rule();
+                else subscription.Filter = new FalseRuleFilter();
+            });
+            Assert.Equal(1, controlCalls);
+            Assert.Empty(control.Validate());
+        }
+
+        int callbackCalls = 0;
+        IServiceBusConsumeTopologyConfigurator topology = ConsumeTopology();
+        Subscribe(topology, typed, subscription =>
+        {
+            callbackCalls++;
+            subscription.Rule = Rule();
+            subscription.Filter = new FalseRuleFilter();
+        });
+        Assert.Equal(1, callbackCalls);
+
+        // Current F fails here: no validation failure survives the specification.
+        Assert.Equal(new[] { "Rule/Filter" }, topology.Validate()
+            .Where(result => result.Disposition == ValidationResultDisposition.Failure)
+            .Select(result => result.Key).ToArray());
+    }
