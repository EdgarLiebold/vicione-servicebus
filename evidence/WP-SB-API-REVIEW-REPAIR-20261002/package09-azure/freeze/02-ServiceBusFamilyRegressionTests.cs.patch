+    [Fact]
+    [RequirementCoverage("REQ-VSB-ASB-TOPOLOGY", "default-session-formatter-reaches-send-filter-with-explicit-override")]
+    public async Task DefaultSessionFormatter_ReachesTheSendFilterAndPreservesExplicitOverridesAsync()
+    {
+        // Positive control: the ordinary message-specific extension already works.
+        var overriddenDefault = new RecordingSessionFormatter("default-session");
+        ISendTopologyConfigurator overridden = SendTopology(overriddenDefault);
+        overridden.UseSessionIdFormatter<FamilyMessage>(_ => "message-session");
+        AzureServiceBusSendContext<FamilyMessage> explicitContext = await ApplySessionTopologyAsync(overridden);
+        Assert.Equal("message-session", explicitContext.SessionId);
+        Assert.Equal("message-session", explicitContext.PartitionKey);
+        Assert.Equal(0, overriddenDefault.Calls);
+
+        // Null formatter result must not remove explicitly supplied routing metadata.
+        ISendTopologyConfigurator empty = SendTopology(new RecordingSessionFormatter(null));
+        AzureServiceBusSendContext<FamilyMessage> preserved = await ApplySessionTopologyAsync(empty, "already-explicit");
+        Assert.Equal("already-explicit", preserved.SessionId);
+        Assert.Equal("already-explicit", preserved.PartitionKey);
+
+        var formatter = new RecordingSessionFormatter("default-session");
+        ISendTopologyConfigurator topology = SendTopology(formatter);
+        AzureServiceBusSendContext<FamilyMessage> context = await ApplySessionTopologyAsync(topology);
+
+        // Current F fails here: actual null. Cache Factory created a null formatter.
+        Assert.Equal("default-session", context.SessionId);
+        Assert.Equal("default-session", context.PartitionKey);
+        Assert.Equal(1, formatter.Calls);
+        Assert.Same(context.Message, formatter.LastMessage);
+    }
