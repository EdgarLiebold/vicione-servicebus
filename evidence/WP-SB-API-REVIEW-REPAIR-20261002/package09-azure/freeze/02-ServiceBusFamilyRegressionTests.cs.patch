+    static void Subscribe(IServiceBusConsumeTopologyConfigurator topology, bool typed,
+        Action<IServiceBusSubscriptionConfigurator> configure)
+    {
+        if (typed) topology.GetMessageTopology<FamilyMessage>().Subscribe("review-forward", configure);
+        else topology.Subscribe("review-topic", "review-forward", configure);
+    }
