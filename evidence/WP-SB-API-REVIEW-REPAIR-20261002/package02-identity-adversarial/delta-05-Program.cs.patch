+static T Throws<T>(Action operation) where T : Exception
+{
+    try { operation(); }
+    catch (T exception) when (exception.GetType() == typeof(T)) { return exception; }
+    throw new InvalidOperationException("Expected exact " + typeof(T).Name + " was not thrown");
+}
