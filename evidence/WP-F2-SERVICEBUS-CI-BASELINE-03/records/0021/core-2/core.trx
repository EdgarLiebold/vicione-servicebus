7 [shape=rectangle, label="ProcessGetInventory.Faulted&lt;ReadInventory&gt;"];
8 [shape=rectangle, label="ProcessGetInventory.TimeoutExpired&lt;RequestTimeoutExpired`1&gt;"];
0 -&gt; 5;
1 -&gt; 6;
1 -&gt; 7;
1 -&gt; 8;
5 -&gt; 1;
6 -&gt; 2;
7 -&gt; 3;
8 -&gt; 4;
}</StdOut>
