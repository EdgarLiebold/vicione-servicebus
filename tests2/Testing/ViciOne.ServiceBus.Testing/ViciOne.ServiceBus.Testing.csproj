<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Shared test infrastructure: not a test project and not an executable, it owns no test case
         and produces no verdict. IsTestProject is left unset rather than declared false, because
         classification follows the evidence - this project references no test entry package, so
         tests2/Directory.Build.targets classifies it as a non-test project without being told. -->
    <RootNamespace>ViciOne.ServiceBus.Testing</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Deliberately no xUnit and no test-platform package. This library must stay framework-neutral
         so that a later change of assertion library or runner cannot reach into it. -->
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
  </ItemGroup>

</Project>
