<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared, framework-neutral test infrastructure. It owns no test case and no verdict. -->

  <ItemGroup>
    <!-- The architecture project tests this internal infrastructure without making test-only
         injection seams part of the reusable public surface. -->
    <InternalsVisibleTo Include="ViciOne.ServiceBus.Architecture.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Deliberately no xUnit, MTP or architecture-test adapter. -->
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
  </ItemGroup>

</Project>
