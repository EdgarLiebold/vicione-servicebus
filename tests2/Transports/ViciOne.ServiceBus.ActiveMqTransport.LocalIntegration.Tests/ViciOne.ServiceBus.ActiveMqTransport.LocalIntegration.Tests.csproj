      Include="../ViciOne.ServiceBus.ActiveMqTransport.Tests/Infrastructure/ReceiveEndpointRecoveryObserver.cs"
      Link="Infrastructure/ReceiveEndpointRecoveryObserver.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Requirements/ActiveMqLocalIntegrationRequirements.json" />
    <EmbeddedResource
      Include="Requirements/ActiveMqLocalIntegrationRequirements.json"
      LogicalName="ViciOne.ServiceBus.ActiveMqTransport.LocalIntegration.Tests.Requirements.ActiveMqLocalIntegrationRequirements.json" />
  </ItemGroup>
