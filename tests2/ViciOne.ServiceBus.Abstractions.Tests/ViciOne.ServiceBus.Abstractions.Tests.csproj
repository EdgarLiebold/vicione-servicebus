<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Microsoft Testing Platform test projects are executables: the artifact starts, runs the
         tests and owns the process exit code. -->
    <OutputType>Exe</OutputType>
    <!-- This repository has one test host: Microsoft Testing Platform v2. Without this property,
         xUnit generates a hybrid entry point whose direct execution uses the in-process runner;
         that can make direct execution pass while `dotnet test` discovers no tests. -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <!-- Declared explicitly by the project that is one. tests2/Directory.Build.targets cross-checks
         this declaration against the direct xunit.v3.mtp-v2 reference in both directions, so neither
         the declaration nor the reference can be dropped without an error naming which one is
         missing. -->
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- The single test entry package. It brings discovery, assertions and the Microsoft Testing
         Platform v2 entry point; nothing else here may bring a runner, an adapter or a logger.
         This cohort needs no architecture library: it observes product behaviour, not structure. -->
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <!-- The one product owner this cohort mirrors. The reference is what makes the type anchors in
         the contract test compile-verified: if one of the five message bodies is renamed or removed,
         this project stops compiling instead of silently asserting against a stale name list.
         ViciOne.ServiceBus is deliberately absent - the bodies under test are declared here, and a
         reference to the core assembly would let a core type answer for an abstractions contract. -->
    <ProjectReference Include="../../src/ViciOne.ServiceBus.Abstractions/ViciOne.ServiceBus.Abstractions.csproj" />
    <ProjectReference Include="../Testing/ViciOne.ServiceBus.Tests.Infrastructure/ViciOne.ServiceBus.Tests.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The immutable MessageBody requirement projection, embedded so the compiled test assembly
         contains the exact projection it verifies. Embedding rather than reading from disk is what
         keeps this a single artifact with no second runtime configuration path.
         The explicit None removal is not preventing a copy - a None item carries nothing into the
         output by itself. It keeps the file out of @(None), so the one file appears in exactly one
         item list and the evaluated item lists stay an honest answer to what this project does with
         it. -->
    <None Remove="Requirements/MessageBodyRequirements.json" />
    <EmbeddedResource
      Include="Requirements/MessageBodyRequirements.json"
      LogicalName="ViciOne.ServiceBus.Abstractions.Tests.Requirements.MessageBodyRequirements.json" />
  </ItemGroup>

</Project>
