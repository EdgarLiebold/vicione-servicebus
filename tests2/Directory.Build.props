<Project>

  <!-- The early half of the native test tree's build contract.

       MSBuild imports only the FIRST Directory.Build.props it finds walking up from a project, and
       for everything under tests2/ that is this file rather than the repository root one. The root
       contract - locked restore, the single artifacts output root, the packaging notice and the
       target framework fence - would therefore silently not apply. The import below is what makes
       it apply, and it carries no Exists() guard on purpose: this is a required import, not an
       optional developer override, so a missing parent must fail the build rather than be skipped.
       Directory.Build.targets proves separately that it actually happened. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- One target framework for the whole tree. LangVersion is deliberately not pinned: the C#
         version follows the SDK.

         IsTestProject is deliberately NOT set here. This file is evaluated before the project body,
         so it cannot classify a project, and a blanket value would label the non-executable,
         xUnit-free support library a test project too. Each executable test project declares it
         itself, and Directory.Build.targets verifies that declaration against the evidence that
         actually makes a project a test project: its direct reference to the test entry package. -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- One credential store for the whole native test tree. Repeating the id per executable
         project would create as many stores as projects, and a secret placed in one of them would
         be invisible to the others - the failure looks like a missing secret and is actually a
         second store. The configuration owner resolves exactly this id. -->
    <UserSecretsId>vicione-servicebus-native-tests</UserSecretsId>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The checkpoint owes a zero-warning build, so a warning has to stop it rather than scroll
         past. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- One exact package-policy source for both the effective MSBuild gate and the resolved-closure
       architecture tests. These are second verdict paths, framework adapters or VSTest artifacts;
       Microsoft Testing Platform itself and the framework-neutral ArchUnitNET core are required. -->
  <ItemGroup>
    <ViciOneForbiddenNativeTestPackage Include="GitHubActionsTestLogger" />
    <ViciOneForbiddenNativeTestPackage Include="Microsoft.NET.Test.Sdk" />
    <ViciOneForbiddenNativeTestPackage Include="Microsoft.Testing.Extensions.VSTestBridge" />
    <ViciOneForbiddenNativeTestPackage Include="Microsoft.TestPlatform.ObjectModel" />
    <ViciOneForbiddenNativeTestPackage Include="Microsoft.TestPlatform.TestHost" />
    <ViciOneForbiddenNativeTestPackage Include="MSTest" />
    <ViciOneForbiddenNativeTestPackage Include="MSTest.TestAdapter" />
    <ViciOneForbiddenNativeTestPackage Include="MSTest.TestFramework" />
    <ViciOneForbiddenNativeTestPackage Include="NUnit" />
    <ViciOneForbiddenNativeTestPackage Include="NUnit3TestAdapter" />
    <ViciOneForbiddenNativeTestPackage Include="NUnit.Analyzers" />
    <ViciOneForbiddenNativeTestPackage Include="NUnitLite" />
    <ViciOneForbiddenNativeTestPackage Include="TngTech.ArchUnitNET.xUnit" />
    <ViciOneForbiddenNativeTestPackage Include="TngTech.ArchUnitNET.xUnitV3" />
    <ViciOneForbiddenNativeTestPackage Include="TngTech.ArchUnitNET.NUnit" />
    <ViciOneForbiddenNativeTestPackage Include="TngTech.ArchUnitNET.MSTestV2" />
    <ViciOneForbiddenNativeTestPackage Include="TngTech.ArchUnitNET.TUnit" />
    <ViciOneForbiddenNativeTestPackage Include="xunit.runner.visualstudio" />
  </ItemGroup>

</Project>
