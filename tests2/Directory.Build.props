<Project>

  <!-- The early half of the native test tree's build contract.

       MSBuild imports only the FIRST Directory.Build.props it finds walking up from a project, and
       for everything under tests2/ that is this file rather than the repository root one. The root
       contract - locked restore, the single artifacts output root, the packaging notice and the
       target framework fence - would therefore silently not apply. The import below is what makes
       it apply, and it carries no Exists() guard on purpose: this is a required import, not an
       optional developer override, so a missing parent must fail the build rather than be skipped.
       Directory.Build.targets proves separately that it actually happened. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- One target framework for the whole tree. LangVersion is deliberately not pinned: the C#
         version follows the SDK.

         IsTestProject is deliberately NOT set here. This file is evaluated before the project body,
         so it cannot classify a project, and a blanket value would label the non-executable,
         xUnit-free support library a test project too. Each executable test project declares it
         itself, and Directory.Build.targets verifies that declaration against the evidence that
         actually makes a project a test project: its direct reference to the test entry package. -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- One credential store for the whole native test tree. Repeating the id per executable
         project would create as many stores as projects, and a secret placed in one of them would
         be invisible to the others - the failure looks like a missing secret and is actually a
         second store. The configuration owner resolves exactly this id. -->
    <UserSecretsId>vicione-servicebus-native-tests</UserSecretsId>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The checkpoint owes a zero-warning build, so a warning has to stop it rather than scroll
         past. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- The native core project keeps the product-facing project name while its artifacts use the
       UnitArchitecture role identity. This property must be set during Directory.Build.props
       evaluation, before the SDK fixes BaseIntermediateOutputPath. -->
  <PropertyGroup Condition=" '$(MSBuildProjectName)' == 'ViciOne.ServiceBus.Tests' ">
    <ArtifactsProjectName>ViciOne.ServiceBus.Tests.Unit</ArtifactsProjectName>
  </PropertyGroup>

  <!-- The inherited SQL transport project remains in the engineering graph until its provider
       integration owners are complete. Keep the native hermetic owner in a distinct artifacts
       directory so the two projects cannot race over one project.assets.json during that overlap. -->
  <PropertyGroup Condition=" '$(MSBuildProjectName)' == 'ViciOne.ServiceBus.SqlTransport.Tests' ">
    <ArtifactsProjectName>ViciOne.ServiceBus.SqlTransport.Tests.Unit</ArtifactsProjectName>
  </PropertyGroup>

</Project>
