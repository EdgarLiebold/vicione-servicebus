<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../../../signing.props" />

  <PropertyGroup>
    <!-- Documentation is completed in work package C; until then CS1591 stays a warning here. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/Scheduling/ViciOne.ServiceBus.Quartz/ViciOne.ServiceBus.Quartz.csproj" />
    <ProjectReference Include="../../../src/ViciOne.ServiceBus.Testing/ViciOne.ServiceBus.Testing.csproj" />
    <ProjectReference Include="../../Testing/ViciOne.ServiceBus.Tests.Infrastructure/ViciOne.ServiceBus.Tests.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Requirements/QuartzInheritedBehaviorDisposition.json" />
    <None Remove="Requirements/QuartzIntegrationRequirements.json" />
    <EmbeddedResource
      Include="Requirements/QuartzInheritedBehaviorDisposition.json"
      LogicalName="ViciOne.ServiceBus.Quartz.Tests.Requirements.QuartzInheritedBehaviorDisposition.json" />
    <EmbeddedResource
      Include="Requirements/QuartzIntegrationRequirements.json"
      LogicalName="ViciOne.ServiceBus.Quartz.Tests.Requirements.QuartzIntegrationRequirements.json" />
  </ItemGroup>

</Project>
