<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Infrastructure the test projects share, not a suite of its own: it declares no test, so a
         runner must not collect it, and it is never packed. -->
    <IsTestProject>false</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
