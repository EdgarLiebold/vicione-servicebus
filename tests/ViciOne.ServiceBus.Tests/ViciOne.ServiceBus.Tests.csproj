<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../signing.props" />

  <PropertyGroup>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Serialization/Protobuf/ProtobufCompatibilityPayload.proto" GrpcServices="None" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/ViciOne.ServiceBus.Courier/ViciOne.ServiceBus.Courier.csproj" />
    <ProjectReference Include="../../src/ViciOne.ServiceBus.Futures/ViciOne.ServiceBus.Futures.csproj" />
    <ProjectReference Include="../../src/ViciOne.ServiceBus.Initializers/ViciOne.ServiceBus.Initializers.csproj" />
    <ProjectReference Include="../../src/ViciOne.ServiceBus.JobService/ViciOne.ServiceBus.JobService.csproj" />
    <ProjectReference Include="../../src/ViciOne.ServiceBus.Mediator/ViciOne.ServiceBus.Mediator.csproj" />
    <ProjectReference Include="../../src/ViciOne.ServiceBus.Sagas/ViciOne.ServiceBus.Sagas.csproj" />
    <ProjectReference Include="../../src/ViciOne.ServiceBus/ViciOne.ServiceBus.csproj" />
    <ProjectReference Include="../../src/ViciOne.ServiceBus.Testing/ViciOne.ServiceBus.Testing.csproj" />
    <ProjectReference Include="../Testing/ViciOne.ServiceBus.Tests.Infrastructure/ViciOne.ServiceBus.Tests.Infrastructure.csproj" />
    <ProjectReference Include="../Testing/ViciOne.ServiceBus.Tests.InternalAccess/ViciOne.ServiceBus.Tests.InternalAccess.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Requirements/CoreRequirements.json" />
    <EmbeddedResource
      Include="Requirements/CoreRequirements.json"
      LogicalName="ViciOne.ServiceBus.Tests.Requirements.CoreRequirements.json" />
  </ItemGroup>

</Project>
