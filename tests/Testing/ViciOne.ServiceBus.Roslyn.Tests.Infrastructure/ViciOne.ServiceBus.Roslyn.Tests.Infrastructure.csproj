<Project Sdk="Microsoft.NET.Sdk">

  <!-- Framework-neutral Roslyn test infrastructure. It owns no test case and no verdict. -->

  <PropertyGroup>
    <!-- Keep the reusable Roslyn surface under the one common test-infrastructure namespace while
         the assembly name continues to identify its specialized implementation role. -->
    <RootNamespace>ViciOne.ServiceBus.Tests.Infrastructure.Roslyn</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
  </ItemGroup>

</Project>
