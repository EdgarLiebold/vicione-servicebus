<Project Sdk="Microsoft.NET.Sdk">

  <!-- Framework-neutral test infrastructure. It owns no test case and no verdict. -->

  <PropertyGroup>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Dedicated infrastructure tests exercise internal behavior without making test-only
         injection seams part of the reusable public surface. -->
    <InternalsVisibleTo Include="ViciOne.ServiceBus.Tests.Infrastructure.Tests" />
    <InternalsVisibleTo Include="ViciOne.ServiceBus.ActiveMq.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Deliberately no xUnit, MTP or architecture-test adapter. -->
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
  </ItemGroup>

</Project>
