<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Documentation is completed in work package C; until then CS1591 stays a warning here. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Microsoft Testing Platform test projects are executables: the artifact starts, runs the
         tests and owns the process exit code. -->
    <OutputType>Exe</OutputType>
    <!-- This repository has one test host: Microsoft Testing Platform v2. Without this property,
         xUnit generates a hybrid entry point whose direct execution uses the in-process runner;
         that can make direct execution pass while `dotnet test` discovers no tests. -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <!-- Declared explicitly by the project that is one. tests/Directory.Build.targets cross-checks
         this declaration against the direct xunit.v3.mtp-v2 reference in both directions, so neither
         the declaration nor the reference can be dropped without an error naming which one is
         missing. -->
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- The single test entry package. It brings discovery, assertions and the Microsoft Testing
         Platform v2 entry point; nothing else here may bring a runner, an adapter or a logger. -->
    <PackageReference Include="xunit.v3.mtp-v2" />
    <!-- Framework-neutral core only. The ArchUnitNET.xUnit adapter is deliberately not referenced:
         its fluent Check() would be a second assertion path beside xUnit's own. -->
    <PackageReference Include="TngTech.ArchUnitNET" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real product projects. These references are what make the type anchors in
         ProductAssemblyFacts compile-verified: if a product type moves or disappears, this project
         stops compiling instead of silently asserting against a stale hand-written list. -->
    <ProjectReference Include="../../../src/ViciOne.ServiceBus/ViciOne.ServiceBus.csproj" />
    <ProjectReference Include="../../../src/ViciOne.ServiceBus.Abstractions/ViciOne.ServiceBus.Abstractions.csproj" />
    <ProjectReference Include="../../Testing/ViciOne.ServiceBus.Analyzers.Tests.Infrastructure/ViciOne.ServiceBus.Analyzers.Tests.Infrastructure.csproj" />
    <ProjectReference Include="../../Testing/ViciOne.ServiceBus.Roslyn.Tests.Infrastructure/ViciOne.ServiceBus.Roslyn.Tests.Infrastructure.csproj" />
    <ProjectReference Include="../../Testing/ViciOne.ServiceBus.Tests.Infrastructure/ViciOne.ServiceBus.Tests.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The durable architecture requirement projection is part of the test project itself. -->
    <None Remove="Requirements/ArchitectureFoundationRequirements.json" />
    <EmbeddedResource
      Include="Requirements/ArchitectureFoundationRequirements.json"
      LogicalName="ViciOne.ServiceBus.Architecture.Tests.Requirements.ArchitectureFoundationRequirements.json" />
  </ItemGroup>

</Project>
