<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../signing.props" />

  <PropertyGroup>
    <!-- Documentation is completed in work package C; until then CS1591 stays a warning here. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/Persistence/ViciOne.ServiceBus.EntityFrameworkCore/ViciOne.ServiceBus.EntityFrameworkCore.csproj" />
    <ProjectReference Include="../../../src/Persistence/ViciOne.ServiceBus.EntityFrameworkCore.Sagas/ViciOne.ServiceBus.EntityFrameworkCore.Sagas.csproj" />
    <ProjectReference Include="../../../src/ViciOne.ServiceBus.Testing/ViciOne.ServiceBus.Testing.csproj" />
    <ProjectReference Include="../../Testing/ViciOne.ServiceBus.Tests.InternalAccess/ViciOne.ServiceBus.Tests.InternalAccess.csproj" />
    <ProjectReference Include="../../Testing/ViciOne.ServiceBus.Tests.Infrastructure/ViciOne.ServiceBus.Tests.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Requirements/EntityFrameworkRequirements.json" />
    <EmbeddedResource
      Include="Requirements/EntityFrameworkRequirements.json"
      LogicalName="ViciOne.ServiceBus.EntityFrameworkCore.Tests.Requirements.EntityFrameworkRequirements.json" />
    <EmbeddedResource
      Include="../../../docs/migrations/reliable-messaging-sqlite.sql"
      Link="MigrationScripts/reliable-messaging-sqlite.sql"
      LogicalName="ViciOne.ServiceBus.EntityFrameworkCore.Tests.MigrationScripts.reliable-messaging-sqlite.sql" />
    <EmbeddedResource
      Include="../../../docs/migrations/reliable-messaging-postgresql.sql"
      Link="MigrationScripts/reliable-messaging-postgresql.sql"
      LogicalName="ViciOne.ServiceBus.EntityFrameworkCore.Tests.MigrationScripts.reliable-messaging-postgresql.sql" />
    <EmbeddedResource
      Include="../../../docs/migrations/reliable-messaging-sqlserver.sql"
      Link="MigrationScripts/reliable-messaging-sqlserver.sql"
      LogicalName="ViciOne.ServiceBus.EntityFrameworkCore.Tests.MigrationScripts.reliable-messaging-sqlserver.sql" />
  </ItemGroup>

</Project>
