<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Documentation is completed in work package C; until then CS1591 stays a warning here. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../benchmarks/ViciOne.ServiceBus.Benchmark/ViciOne.ServiceBus.Benchmark.csproj" />
    <ProjectReference Include="../../../benchmarks/ViciOne.ServiceBus.BenchmarkConsole/ViciOne.ServiceBus.BenchmarkConsole.csproj" />
    <ProjectReference Include="../../Testing/ViciOne.ServiceBus.Tests.Infrastructure/ViciOne.ServiceBus.Tests.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Requirements/BenchmarkRequirements.json" />
    <EmbeddedResource
      Include="Requirements/BenchmarkRequirements.json"
      LogicalName="ViciOne.ServiceBus.Benchmark.Tests.Requirements.BenchmarkRequirements.json" />
  </ItemGroup>

</Project>
